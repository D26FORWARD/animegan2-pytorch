            "source": [
                "def convert_and_save(tf_checkpoint_path, save_name):\n",
                "\n",
                "    tf_weights = load_tf_weights(tf_checkpoint_path)\n",
                "    \n",
                "    torch_net = Generator() # PyTorch model instance\n",
                "    torch_weights = torch_net.state_dict()\n",
                "\n",
                "    torch_converted_weights = {}\n",
                "    for k, v in tf_weights.items():\n",
                "        torch_k, is_dconv = convert_keys(k)\n",
                "        assert torch_k in torch_weights, f\"weight name mismatch: TF key '{k}' converted to PT key '{torch_k}' which is not in PT model state_dict\"\n",
                "\n",
                "        converted_weight = torch.from_numpy(v)\n",
                "        if len(converted_weight.shape) == 4: # Typically convolutional weights\n",
                "            if is_dconv: # Special handling for dconv (likely depthwise or specific type of conv)\n",
                "                # TF: [filter_height, filter_width, in_channels, channel_multiplier] for DepthwiseConv2D\n",
                "                # or TF: [filter_height, filter_width, out_channels, in_channels/groups] for some grouped conv?\n",
                "                # PT: [out_channels, in_channels/groups, filter_height, filter_width] for Conv2d\n",
                "                # PT (depthwise): [out_channels (in_channels*multiplier), 1, filter_height, filter_width] if using groups=in_channels\n",
                "                # The permutation (2, 3, 0, 1) suggests TF format might be [H, W, C_out, C_in] or similar unusual one for this specific 'dconv'.\n",
                "                # Or, if TF is [H, W, C_in_multiplier, C_out_real] and PT is [C_out_real, C_in_multiplier, H, W]\n",
                "                converted_weight = converted_weight.permute(2, 3, 0, 1) # Example: (H, W, D_out, D_in) -> (D_out, D_in, H, W)\n",
                "            else: # Standard convolutional weights\n",
                "                # TF: [filter_height, filter_width, in_channels, out_channels]\n",
                "                # PT: [out_channels, in_channels, filter_height, filter_width]\n",
                "                converted_weight = converted_weight.permute(3, 2, 0, 1) # (H, W, C_in, C_out) -> (C_out, C_in, H, W)\n",
                "\n",
                "        # Dimension check for non-4D weights (e.g., bias, LayerNorm weights/biases)\n",
                "        assert torch_weights[torch_k].shape == converted_weight.shape, \\\n",
                "            f\"Shape mismatch for key '{torch_k}' (original TF key '{k}'): \\n\"\\\n",
                "            f\"  TF shape (after potential numpy conversion): {v.shape}, PT shape: {torch_weights[torch_k].shape}\\n\"\\\n",
                "            f\"  Converted PT shape: {converted_weight.shape}\"\n",
                "\n",
                "        torch_converted_weights[torch_k] = converted_weight\n",
                "\n",
                "    # Final check: ensure all keys in the PyTorch model state_dict were covered\n",
                "    assert sorted(list(torch_converted_weights)) == sorted(list(torch_weights)), \\\n",
                "        f\"Weight key mismatch after conversion. Missing keys in converted: \"\\\n",
                "        f\"{set(torch_weights.keys()) - set(torch_converted_weights.keys())}, \"\\\n",
                "        f\"Extra keys in converted: {set(torch_converted_weights.keys()) - set(torch_weights.keys())}\"\n",
                "        \n",
                "    torch_net.load_state_dict(torch_converted_weights)\n",
                "    torch.save(torch_net.state_dict(), save_name)\n",
                "    print(f\"PyTorch model saved at {save_name}\")"
